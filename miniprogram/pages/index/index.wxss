/* pages/index/index.wxss */
.header {
  text-align: center;
  padding: 60rpx 0 40rpx;
}
.title {
  font-size: 56rpx;
  font-weight: 700;
  color: #1A1B1C;
  letter-spacing: 4rpx;
}
.subtitle {
  font-size: 26rpx;
  color: #6B7280;
  margin-top: 12rpx;
}
.search-card {
  background: #FFFFFF;
  border-radius: 20rpx;
  padding: 32rpx;
  margin-bottom: 32rpx;
}
.search-label {
  font-size: 28rpx;
  font-weight: 600;
  margin-bottom: 16rpx;
  color: #1A1B1C;
}
.search-input {
  width: 100%;
  min-height: 160rpx;
  background: #F4F3EE;
  border-radius: 12rpx;
  padding: 20rpx;
  font-size: 28rpx;
  box-sizing: border-box;
  margin-bottom: 24rpx;
}
.search-btn {
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
}
.section-title {
  font-size: 28rpx;
  font-weight: 600;
  margin-bottom: 20rpx;
  color: #1A1B1C;
}
.hot-section {
  margin-bottom: 32rpx;
}
.hot-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}
.hot-tag {
  background: #FFFFFF;
  padding: 12rpx 24rpx;
  border-radius: 24rpx;
  font-size: 26rpx;
  color: #5B6BB5;
  border: 1rpx solid rgba(158,172,234,0.3);
}
.history-section {
  margin-bottom: 32rpx;
}
.history-list {
  background: #FFFFFF;
  border-radius: 16rpx;
  overflow: hidden;
}
.history-item {
  padding: 24rpx;
  border-bottom: 1rpx solid #F0EFEA;
}
.history-item:last-child {
  border-bottom: none;
}
.history-desc {
  font-size: 28rpx;
  color: #1A1B1C;
  margin-bottom: 8rpx;
}
.history-time {
  font-size: 22rpx;
  color: #9CA3AF;
}
.footer {
  text-align: center;
  padding: 40rpx 0;
  font-size: 22rpx;
  color: #9CA3AF;
}
